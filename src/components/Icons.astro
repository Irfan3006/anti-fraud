---
interface Props {
  name:
    | 'shield'
    | 'shield-check'
    | 'lock'
    | 'unlock'
    | 'camera'
    | 'map-pin'
    | 'cpu'
    | 'check'
    | 'x'
    | 'alert-triangle'
    | 'arrow-right'
    | 'copy'
    | 'external-link'
    | 'refresh-cw'
    | 'file-text'
    | 'user'
    | 'log-out'
    | 'zap'
    | 'edit'
    | 'settings'
    | 'sliders'
    | 'globe'
    | 'smartphone'
    | 'trash-2'
    | 'trash'
    | 'info'
    | 'home'
    | 'arrow-left'
    | 'eye'
    | 'search';
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 20 } = Astro.props;
