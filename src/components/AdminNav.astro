---
import Icons from './Icons.astro';

interface Props {
  currentTab?: 'dashboard' | 'create' | 'logs';
}

const { currentTab = 'dashboard' } = Astro.props;
---

<div class="admin-subnav">
  <div class="container admin-nav-container">
    <div class="admin-nav-tabs">
      <a
        href="/admin"
        class={`btn admin-nav-btn ${currentTab === 'dashboard' ? 'btn-primary' : 'btn-secondary'}`}
      >
        <Icons name="file-text" size={15} /> <span>Overview &amp; Logs</span>
      </a>

      <a
        href="/admin/create"
        class={`btn admin-nav-btn ${currentTab === 'create' ? 'btn-primary' : 'btn-secondary'}`}
      >
        <Icons name="shield-check" size={15} /> <span>Create New Nota</span>
      </a>
    </div>

    <div class="admin-nav-actions">
      <button
        type="button"
        id="test-telegram-btn"
        class="btn btn-secondary admin-nav-btn"
        title="Uji kirim notifikasi ke Bot Telegram"
      >
        <Icons name="zap" size={14} /> <span id="test-telegram-btn-label">Test Bot</span>
      </button>

      <a
        href="/nota/8f92a7c1"
        target="_blank"
        class="btn btn-secondary admin-nav-btn demo-btn"
      >
        <Icons name="external-link" size={14} /> <span>View Demo</span>
      </a>

      <form action="/api/auth/logout" method="POST" class="logout-form">
        <button
          type="submit"
          class="btn btn-secondary admin-nav-btn logout-btn"
        >
          <Icons name="log-out" size={14} /> <span>Logout</span>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  const testBtn = document.getElementById('test-telegram-btn');
  const btnLabel = document.getElementById('test-telegram-btn-label');

  testBtn?.addEventListener('click', async () => {
    if (!testBtn || !btnLabel) return;
    const origText = btnLabel.textContent;
    btnLabel.textContent = 'Mengirim...';
    testBtn.setAttribute('disabled', 'true');

    try {
      const res = await fetch('/api/admin/test-telegram', { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        alert('✅ ' + data.message);
      } else {
        alert('❌ Gagal: ' + (data.message || data.error?.message || 'Tidak diketahui'));
      }
    } catch (err: any) {
      alert('❌ Error menghubungi server: ' + err.message);
    } finally {
      btnLabel.textContent = origText;
      testBtn.removeAttribute('disabled');
    }
  });
</script>

<style>
  .admin-subnav {
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-gray-200);
    margin-bottom: 1.75rem;
    width: 100%;
  }

  .admin-nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .admin-nav-tabs {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 2px;
    max-width: 100%;
  }

  .admin-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .admin-nav-btn {
    padding: 0.4rem 0.75rem;
    font-size: clamp(0.75rem, 1vw + 0.45rem, 0.85rem);
    min-height: 36px;
    white-space: nowrap;
    gap: 0.35rem;
  }

  .logout-form {
    margin: 0;
    display: inline-block;
  }

  .logout-btn {
    color: var(--color-danger-600);
    border-color: var(--color-danger-border);
  }

  .logout-btn:hover {
    background-color: var(--color-danger-50);
  }

  @media (max-width: 540px) {
    .admin-nav-container {
      flex-direction: column;
      align-items: stretch;
    }
    .admin-nav-tabs, .admin-nav-actions {
      width: 100%;
      justify-content: flex-start;
    }
    .admin-nav-btn {
      flex: 1;
    }
  }

  @media (max-width: 320px) {
    .admin-nav-btn span {
      font-size: 0.75rem;
    }
    .admin-nav-btn {
      padding: 0.35rem 0.5rem;
    }
  }
</style>
