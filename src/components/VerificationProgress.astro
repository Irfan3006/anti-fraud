---
import Icons from './Icons.astro';

interface Props {
  currentStep: number; // 1 to 5
}

const { currentStep } = Astro.props;

const steps = [
  { id: 1, label: 'Device Information', icon: 'cpu' },
  { id: 2, label: 'High-Accuracy Location', icon: 'map-pin' },
  { id: 3, label: 'Front Camera Capture', icon: 'camera' },
  { id: 4, label: 'Back Camera Capture', icon: 'camera' },
  { id: 5, label: 'Cryptographic Audit & Validation', icon: 'shield-check' }
];
---

<div class="verification-progress-card">
  <div class="progress-header">
    <span class="progress-title">
      Mandatory Security Flow
    </span>
    <span class="progress-step-counter" id="step-indicator-label">
      {currentStep === 0 ? 'Ready to Start (0 of 5)' : `Step ${Math.min(currentStep, 5)} of 5`}
    </span>
  </div>

  <ul class="step-checklist" id="verificationStepList">
    {steps.map((step) => {
      const isCompleted = currentStep > step.id;
      const isActive = currentStep === step.id;

      return (
        <li
          class={`step-item ${isCompleted ? 'completed' : ''} ${isActive ? 'active' : ''}`}
          id={`step-item-${step.id}`}
        >
          <div class="step-label">
            <span class="step-number">
              {step.id}
            </span>
            <span class="step-text">{step.label}</span>
          </div>

          <div class="step-status" id={`step-status-${step.id}`}>
            {isCompleted && (
              <span class="status-done">
                <Icons name="check" size={15} /> <span>Done</span>
              </span>
            )}
            {isActive && (
              <span class="badge badge-navy status-active-badge">
                In Progress...
              </span>
            )}
            {!isCompleted && !isActive && (
              <span class="status-pending">
                Pending
              </span>
            )}
          </div>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .verification-progress-card {
    margin-bottom: 1.5rem;
    width: 100%;
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .progress-title {
    font-size: clamp(0.72rem, 1vw + 0.4rem, 0.8rem);
    font-weight: 700;
    color: var(--color-navy-900);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .progress-step-counter {
    font-size: clamp(0.72rem, 1vw + 0.4rem, 0.8rem);
    font-weight: 600;
    color: var(--color-blue-600);
  }

  .step-number {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    width: 18px;
    text-align: center;
    color: var(--color-gray-500);
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-text {
    font-size: clamp(0.8rem, 1vw + 0.45rem, 0.875rem);
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .step-status {
    flex-shrink: 0;
    font-size: clamp(0.72rem, 0.8vw + 0.4rem, 0.82rem);
  }

  .status-done {
    color: var(--color-success-600);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 700;
  }

  .status-active-badge {
    background: var(--color-blue-600);
    font-size: 0.7rem;
    padding: 2px 6px;
  }

  .status-pending {
    color: var(--color-gray-400);
  }

  @media (max-width: 320px) {
    .step-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
    .step-status {
      align-self: flex-end;
    }
  }
</style>
