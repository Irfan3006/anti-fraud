---
import Icons from './Icons.astro';

interface Props {
  isAdmin?: boolean;
}

const { isAdmin = false } = Astro.props;
---

<header class="app-header">
  <div class="container header-container">
    <a href="/" class="header-logo">
      <div class="logo-icon-wrapper">
        <Icons name="shield-check" size={18} class="text-white" />
      </div>
      <span class="logo-full-text">ANTI-FRAUD <span style="color: var(--color-blue-400); font-weight: 400;">NOTA</span></span>
      <span class="logo-short-text">AF <span style="color: var(--color-blue-400);">NOTA</span></span>
    </a>

    <nav class="header-nav">
      {isAdmin ? (
        <div class="admin-logged-group">
          <span class="badge badge-navy admin-badge">
            <Icons name="user" size={12} /> <span class="admin-badge-text">Admin</span>
          </span>
          <a href="/admin" class="btn btn-secondary header-btn">
            Dashboard
          </a>
        </div>
      ) : (
        <a href="/admin" class="admin-link">
          <Icons name="lock" size={14} /> <span class="admin-link-text">Admin Portal</span>
        </a>
      )}
    </nav>
  </div>
</header>

<style>
  .app-header {
    background-color: var(--color-navy-900);
    color: var(--color-white);
    border-bottom: 2px solid var(--color-blue-600);
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: var(--safe-top);
    width: 100%;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    height: auto;
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
    gap: 0.5rem;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-white);
    text-decoration: none;
    font-weight: 700;
    font-size: clamp(0.9rem, 1.5vw + 0.5rem, 1.05rem);
    letter-spacing: -0.01em;
    min-width: 0;
  }

  .logo-icon-wrapper {
    background-color: var(--color-blue-600);
    width: clamp(28px, 4vw, 32px);
    height: clamp(28px, 4vw, 32px);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .logo-short-text {
    display: none;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .admin-logged-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .admin-badge {
    border: 1px solid var(--color-navy-700);
    font-size: 0.7rem;
    padding: 0.2rem 0.4rem;
  }

  .header-btn {
    padding: 0.35rem 0.65rem;
    font-size: 0.8rem;
    min-height: 32px;
    background: var(--color-navy-800);
    color: #fff;
    border-color: var(--color-navy-700);
  }

  .admin-link {
    color: var(--color-gray-400);
    font-size: clamp(0.75rem, 1vw + 0.45rem, 0.85rem);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-navy-800);
    min-height: 32px;
    white-space: nowrap;
  }

  .admin-link:hover {
    color: var(--color-white);
    border-color: var(--color-navy-700);
    text-decoration: none;
  }

  /* Watch & Narrow screen adaptations */
  @media (max-width: 380px) {
    .logo-full-text {
      display: none;
    }
    .logo-short-text {
      display: inline-block;
      font-size: 0.85rem;
    }
    .admin-link-text {
      display: none;
    }
    .admin-badge-text {
      display: none;
    }
  }

  @media (max-width: 280px) {
    .header-container {
      padding-left: 0.25rem;
      padding-right: 0.25rem;
    }
    .header-logo {
      gap: 0.3rem;
    }
    .logo-icon-wrapper {
      width: 24px;
      height: 24px;
    }
  }
</style>
