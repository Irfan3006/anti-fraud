---
import Layout from '../../../layouts/Layout.astro';
import Icons from '../../../components/Icons.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { verifyAdminSessionToken, formatWIB } from '../../../lib/security';
import { getAdminCookie } from '../../../lib/session';
import { getNota, getLogsForNota } from '../../../lib/storage';
import { fetchLiveSheetLogs } from '../../../lib/apps-script';
import { resolveExactDeviceModel } from '../../../lib/device-resolver';

export const prerender = false;

// Admin authentication guard
const adminToken = getAdminCookie(Astro.cookies);
if (!verifyAdminSessionToken(adminToken)) {
  return Astro.redirect('/admin/login', 302);
}

const { id } = Astro.params;
const nota = id ? getNota(id) : null;

if (!nota) {
  return Astro.redirect('/admin', 302);
}

// Fetch live sheet records
const liveSheetLogs = await fetchLiveSheetLogs().catch(() => []);
const localLogs = getLogsForNota(nota.id);

const logMap = new Map();
liveSheetLogs.filter((l) => l.notaId === nota.id).forEach((l) => logMap.set(l.verificationId, l));
localLogs.forEach((l) => {
  if (!logMap.has(l.verificationId)) {
    logMap.set(l.verificationId, l);
  }
});
const notaLogs = Array.from(logMap.values()).sort(
  (a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()
);

function getDisplayDeviceModel(log: any): string {
  const rawModel = String(log.deviceModel || log.platform || '');
  if (/24117RN76/i.test(rawModel)) {
    return 'Xiaomi Redmi Note 14 4G';
  }
  if (/^Nokia\s+(24[0-9]{2,}|SM-|CPH|RMX|V2)/i.test(rawModel)) {
    return resolveExactDeviceModel({ model: rawModel.replace(/^Nokia\s+/i, '') });
  }

  if (log.deviceModel && log.deviceModel !== '-' && log.deviceModel !== 'iPhone' && log.deviceModel !== 'Android' && log.deviceModel !== 'MacIntel' && log.deviceModel !== 'Win32' && !log.deviceModel.startsWith('Apple iPhone (Apple')) {
    return log.deviceModel;
  }

  let screenWidth = 0;
  let screenHeight = 0;
  if (log.screenResolution && String(log.screenResolution).includes('x')) {
    const parts = String(log.screenResolution).split('x').map((p: string) => parseInt(p.trim(), 10));
    if (parts.length === 2 && !isNaN(parts[0]) && !isNaN(parts[1])) {
      screenWidth = parts[0];
      screenHeight = parts[1];
    }
  }

  const dpr = typeof log.devicePixelRatio === 'number' 
    ? log.devicePixelRatio 
    : (parseFloat(String(log.devicePixelRatio)) || 1);

  return resolveExactDeviceModel({
    userAgent: log.userAgent || '',
    platform: log.platform || '',
    screenWidth,
    screenHeight,
    devicePixelRatio: dpr,
    mobile: log.mobile === true || log.mobile === 'TRUE' || log.mobile === 'true'
  });
}

const siteUrl = Astro.site?.origin || import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321';
const fullUrl = `${siteUrl}/nota/${nota.id}`;
---

<Layout
  title={`Nota Details: ${nota.notaNumber} | Admin`}
  description="Administrative audit records and verification attempts for nota."
  noindex={true}
  isAdmin={true}
>
  <AdminNav currentTab="dashboard" />

  <div class="container nota-admin-container">
    <!-- Breadcrumb & Back -->
    <div class="page-top-nav">
      <a href="/admin" class="back-link">
        &larr; Back to Dashboard
      </a>
      <div class="title-and-action-row">
        <h1 class="nota-header-title">Nota #{nota.notaNumber} ({nota.id})</h1>
        <div class="header-action-group">
          <a href={`/nota/${nota.id}`} target="_blank" class="btn btn-primary btn-open-gate">
            <Icons name="external-link" size={14} /> <span>Open Public Gate</span>
          </a>
        </div>
      </div>
    </div>

    <!-- NOTA DETAILS CARD -->
    <div class="details-cards-grid">
      <div class="card detail-card">
        <h2 class="card-section-title">Document Metadata</h2>
        <div class="metadata-list">
          <div>
            <span class="meta-label">Title:</span>
            <div class="meta-value-bold">{nota.title}</div>
          </div>
          <div>
            <span class="meta-label">Created Date:</span>
            <div class="meta-value-mono">{formatWIB(nota.createdAt)}</div>
          </div>
          <div>
            <span class="meta-label">Created By:</span>
            <div class="meta-value">{nota.createdBy}</div>
          </div>
          <div>
            <span class="meta-label">Verification URL:</span>
            <div class="meta-value-mono text-blue-wrap">
              {fullUrl}
            </div>
          </div>
        </div>
      </div>

      <div class="card detail-card">
        <h2 class="card-section-title">Protected Image Stream</h2>
        <div class="preview-box">
          <img
            src={`/api/nota/${nota.id}/image`}
            alt="Nota Preview"
            class="preview-image"
          />
        </div>
        <p class="preview-caption">
          Confidential original document (unlocked via admin session)
        </p>
      </div>
    </div>

    <!-- LOGS FOR THIS NOTA -->
    <div class="card logs-section-card">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem;">
        <h2 class="card-section-title" style="margin-bottom: 0;">
          <span>Verification Attempts for This Nota</span>
          <span id="nota-logs-badge" class="badge badge-navy" style="font-size: 0.8rem; margin-left: 0.4rem;">{notaLogs.length} Records</span>
        </h2>
        {notaLogs.length > 0 && (
          <button
            type="button"
            id="btn-delete-all-nota-logs"
            data-notaid={nota.id}
            class="btn btn-danger"
            style="padding: 0.35rem 0.75rem; font-size: 0.78rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.35rem; border-radius: var(--radius-sm);"
            title="Hapus semua riwayat verifikasi nota ini"
          >
            <Icons name="trash-2" size={14} /> <span>Hapus Semua Log Nota Ini</span>
          </button>
        )}
      </div>

      {notaLogs.length === 0 ? (
        <p class="empty-logs-text" id="empty-logs-notice">No verification attempts have been recorded for this nota yet.</p>
      ) : (
        <div class="table-responsive audit-table-wrapper">
          <table class="data-table audit-table">
            <thead class="sticky-thead">
              <tr>
                <th>#</th>
                <th>verification_id</th>
                <th>nota_id</th>
                <th>timestamp</th>
                <th>status</th>
                <th>Google Maps (Live Link)</th>
                <th>latitude</th>
                <th>longitude</th>
                <th>location_accuracy</th>
                <th>altitude</th>
                <th>altitude_accuracy</th>
                <th>heading</th>
                <th>speed</th>
                <th>timezone</th>
                <th>ip_address</th>
                <th>user_agent</th>
                <th>platform / device_model</th>
                <th>language</th>
                <th>screen_resolution</th>
                <th>device_pixel_ratio</th>
                <th>hardware_concurrency</th>
                <th>device_memory</th>
                <th>mobile</th>
                <th>front_camera_file</th>
                <th>back_camera_file</th>
                <th>device_hash</th>
                <th>verification_duration</th>
                <th>failure_reason</th>
                <th style="text-align: center; white-space: nowrap;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              {notaLogs.map((log, index) => {
                const hasCoordinates = log.latitude && log.latitude !== '-' && log.longitude && log.longitude !== '-';
                const mapsUrl = hasCoordinates ? `https://www.google.com/maps?q=${log.latitude},${log.longitude}` : '';

                return (
                  <tr id={`audit-row-${log.verificationId}`}>
                    <td style="color: var(--color-gray-400); font-size: 0.75rem;">{index + 1}</td>
                    <td><code style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-blue-600); font-weight: 700;">{log.verificationId}</code></td>
                    <td><strong style="font-family: var(--font-mono); font-size: 0.75rem;">{log.notaId}</strong></td>
                    <td style="white-space: nowrap; color: var(--color-gray-700); font-size: 0.75rem; font-family: var(--font-mono);">{formatWIB(log.timestamp)}</td>
                    <td>
                      {log.status === 'VERIFIED' && (
                        <span class="badge badge-success" style="font-size: 0.7rem; white-space: nowrap; display: inline-flex; align-items: center; gap: 0.25rem;">
                          <Icons name="check" size={11} /> VERIFIED
                        </span>
                      )}
                      {log.status === 'FAILED' && (
                        <span class="badge badge-danger" style="font-size: 0.7rem; white-space: nowrap; display: inline-flex; align-items: center; gap: 0.25rem;">
                          <Icons name="x" size={11} /> FAILED
                        </span>
                      )}
                      {log.status !== 'VERIFIED' && log.status !== 'FAILED' && (
                        <span class="badge badge-gray" style="font-size: 0.7rem;">{log.status}</span>
                      )}
                    </td>
                    <td style="white-space: nowrap;">
                      {hasCoordinates ? (
                        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-blue" style="padding: 0.28rem 0.6rem; font-size: 0.72rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; gap: 0.3rem; min-height: 28px; white-space: nowrap; text-decoration: none; border-radius: 4px;">
                          <Icons name="map-pin" size={12} /> <span>Buka Maps</span> <Icons name="external-link" size={11} />
                        </a>
                      ) : (
                        <span style="color: var(--color-gray-400);">-</span>
                      )}
                    </td>
                    <td style="font-family: var(--font-mono); font-size: 0.75rem;">{log.latitude || '-'}</td>
                    <td style="font-family: var(--font-mono); font-size: 0.75rem;">{log.longitude || '-'}</td>
                    <td style="font-weight: 600; color: var(--color-blue-600); font-size: 0.75rem;">{log.locationAccuracy || '-'}</td>
                    <td style="font-family: var(--font-mono); font-size: 0.75rem;">{log.altitude !== undefined && log.altitude !== null ? log.altitude : '-'}</td>
                    <td style="font-family: var(--font-mono); font-size: 0.75rem;">{log.altitudeAccuracy !== undefined && log.altitudeAccuracy !== null ? log.altitudeAccuracy : '-'}</td>
                    <td style="font-family: var(--font-mono); font-size: 0.75rem;">{log.heading !== undefined && log.heading !== null ? log.heading : '-'}</td>
                    <td style="font-family: var(--font-mono); font-size: 0.75rem;">{log.speed !== undefined && log.speed !== null ? log.speed : '-'}</td>
                    <td style="font-size: 0.75rem;">{log.timezone || '-'}</td>
                    <td style="font-family: var(--font-mono); font-size: 0.75rem;">{log.ipAddress || '-'}</td>
                    <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.7rem;" title={log.userAgent}>{log.userAgent || '-'}</td>
                    <td style="white-space: nowrap; font-size: 0.75rem; font-weight: 600; color: var(--color-blue-700);">{getDisplayDeviceModel(log)}</td>
                    <td style="font-size: 0.75rem;">{log.language || '-'}</td>
                    <td style="font-family: var(--font-mono); font-size: 0.75rem;">{log.screenResolution || '-'}</td>
                    <td style="font-family: var(--font-mono); font-size: 0.75rem;">{log.devicePixelRatio || '-'}</td>
                    <td style="font-family: var(--font-mono); font-size: 0.75rem;">{log.hardwareConcurrency || '-'}</td>
                    <td style="font-family: var(--font-mono); font-size: 0.75rem;">{log.deviceMemory ? `${log.deviceMemory} GB` : '-'}</td>
                    <td>{log.mobile === true || log.mobile === 'true' || log.mobile === 'TRUE' ? <span class="badge badge-blue" style="font-size: 0.65rem;">MOBILE</span> : <span class="badge badge-gray" style="font-size: 0.65rem;">DESKTOP</span>}</td>
                    <td style="font-size: 0.75rem; white-space: nowrap;">
                      {log.frontCameraFile && log.frontCameraFile.startsWith('http') ? (
                        <a href={log.frontCameraFile} target="_blank" rel="noopener noreferrer" style="color: var(--color-blue-600); font-weight: 600; display: inline-flex; align-items: center; gap: 0.25rem;">
                          <Icons name="camera" size={12} /> <span>Foto Depan</span> <Icons name="external-link" size={11} />
                        </a>
                      ) : (
                        <span>{log.frontCameraFile || '-'}</span>
                      )}
                    </td>
                    <td style="font-size: 0.75rem; white-space: nowrap;">
                      {log.backCameraFile && log.backCameraFile.startsWith('http') ? (
                        <a href={log.backCameraFile} target="_blank" rel="noopener noreferrer" style="color: var(--color-blue-600); font-weight: 600; display: inline-flex; align-items: center; gap: 0.25rem;">
                          <Icons name="camera" size={12} /> <span>Foto Belakang</span> <Icons name="external-link" size={11} />
                        </a>
                      ) : (
                        <span>{log.backCameraFile || '-'}</span>
                      )}
                    </td>
                    <td style="font-family: var(--font-mono); font-size: 0.7rem;"><code>{log.deviceHash || '-'}</code></td>
                    <td style="font-family: var(--font-mono); font-size: 0.75rem;">{log.verificationDuration || '-'}</td>
                    <td style="font-size: 0.75rem; color: var(--color-danger-600); font-weight: 600;">{log.failureReason || '-'}</td>
                    <td style="white-space: nowrap; text-align: center;">
                      <button
                        type="button"
                        class="btn btn-danger btn-delete-audit-log"
                        data-id={log.verificationId}
                        style="padding: 0.25rem 0.55rem; font-size: 0.72rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; gap: 0.25rem; border-radius: 4px; min-height: 28px;"
                        title="Hapus log audit ini"
                      >
                        <Icons name="trash-2" size={12} /> <span>Hapus</span>
                      </button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  .nota-admin-container {
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    width: 100%;
  }

  .page-top-nav {
    margin-bottom: 1.5rem;
  }

  .back-link {
    font-size: clamp(0.78rem, 0.9vw + 0.4rem, 0.85rem);
    color: var(--color-gray-500);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .title-and-action-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .nota-header-title {
    font-size: clamp(1.2rem, 2.5vw + 0.4rem, 1.45rem);
  }

  .header-action-group {
    display: flex;
    gap: 0.5rem;
  }

  .btn-open-gate {
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
  }

  .details-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-bottom: 2rem;
  }

  .detail-card {
    padding: clamp(1rem, 2vw + 0.4rem, 1.5rem);
  }

  .card-section-title {
    font-size: clamp(0.95rem, 1.2vw + 0.45rem, 1.1rem);
    margin-bottom: 1rem;
  }

  .metadata-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: clamp(0.8rem, 1vw + 0.45rem, 0.875rem);
  }

  .meta-label {
    color: var(--color-gray-500);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .meta-value-bold {
    font-weight: 600;
    color: var(--color-navy-900);
  }

  .meta-value-mono {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-gray-800);
  }

  .text-blue-wrap {
    word-break: break-all;
    color: var(--color-blue-600);
  }

  .preview-box {
    background: #ffffff;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    text-align: center;
  }

  .preview-image {
    max-width: 100%;
    max-height: 200px;
    object-fit: contain;
  }

  .preview-caption {
    font-size: 0.75rem;
    color: var(--color-gray-500);
    margin-top: 0.5rem;
    text-align: center;
  }

  .logs-section-card {
    padding: clamp(1rem, 2vw + 0.4rem, 1.5rem);
  }

  .empty-logs-text {
    color: var(--color-gray-500);
    font-size: 0.9rem;
  }

  .audit-table-wrapper {
    max-height: 600px;
    overflow: auto;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
  }

  .audit-table {
    font-size: 0.78rem;
  }

  .sticky-thead {
    position: sticky;
    top: 0;
    z-index: 10;
  }

  @media (max-width: 480px) {
    .title-and-action-row {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-open-gate {
      width: 100%;
    }
  }
</style>

<script>
  // Delete Audit Log action handler
  document.querySelectorAll('.btn-delete-audit-log').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      if (!id) return;

      if (!confirm(`Apakah Anda yakin ingin menghapus data log verifikasi ${id}? Tindakan ini tidak dapat dibatalkan.`)) {
        return;
      }

      btn.setAttribute('disabled', 'true');
      btn.textContent = 'Menghapus...';

      try {
        const res = await fetch(`/api/admin/audit-logs?id=${encodeURIComponent(id)}`, {
          method: 'DELETE'
        });
        const json = await res.json();
        if (json.success) {
          const row = document.getElementById(`audit-row-${id}`);
          if (row) {
            row.style.opacity = '0';
            row.style.transition = 'opacity 0.25s ease';
            setTimeout(() => row.remove(), 250);
          }
        } else {
          alert(json.error?.message || 'Gagal menghapus log audit');
          btn.removeAttribute('disabled');
          btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg> <span>Hapus</span>';
        }
      } catch (err: any) {
        alert(err.message || 'Error deleting audit log');
        btn.removeAttribute('disabled');
      }
    });
  });

  // Delete ALL Logs for this Nota
  const btnDeleteAllNota = document.getElementById('btn-delete-all-nota-logs');
  btnDeleteAllNota?.addEventListener('click', async () => {
    const notaId = btnDeleteAllNota.getAttribute('data-notaid');
    if (!notaId) return;

    if (!confirm(`Apakah Anda yakin ingin MENGHAPUS SEMUA RIWAYAT VERIFIKASI untuk nota ${notaId}? Tindakan ini tidak dapat dibatalkan.`)) {
      return;
    }

    btnDeleteAllNota.setAttribute('disabled', 'true');
    btnDeleteAllNota.textContent = 'Menghapus Semua...';

    try {
      const res = await fetch(`/api/admin/audit-logs?notaId=${encodeURIComponent(notaId)}`, {
        method: 'DELETE'
      });
      const json = await res.json();
      if (json.success) {
        const tableWrapper = document.querySelector('.audit-table-wrapper');
        if (tableWrapper) {
          tableWrapper.innerHTML = '<p class="empty-logs-text" style="padding: 1.5rem; text-align: center; color: var(--color-gray-500);">No verification attempts have been recorded for this nota yet.</p>';
        }
        const badge = document.getElementById('nota-logs-badge');
        if (badge) badge.textContent = '0 Records';
        btnDeleteAllNota.style.display = 'none';
      } else {
        alert(json.error?.message || 'Gagal menghapus semua log nota');
        btnDeleteAllNota.removeAttribute('disabled');
        btnDeleteAllNota.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg> <span>Hapus Semua Log Nota Ini</span>';
      }
    } catch (err: any) {
      alert(err.message || 'Error deleting all nota logs');
      btnDeleteAllNota.removeAttribute('disabled');
    }
  });
</script>
