---
import Layout from '../../layouts/Layout.astro';
import Icons from '../../components/Icons.astro';
import { verifyAdminSessionToken } from '../../lib/security';
import { getAdminCookie } from '../../lib/session';

export const prerender = false;

// If already logged in as admin, redirect to /admin dashboard
const adminToken = getAdminCookie(Astro.cookies);
if (verifyAdminSessionToken(adminToken)) {
  return Astro.redirect('/admin', 302);
}
---

<Layout
  title="Admin Portal Login | Anti-Fraud Verification"
  description="Secure administrative dashboard login for managing notas and auditing verification evidence."
  noindex={true}
>
  <div class="admin-login-wrapper">
    <div class="container-narrow">
      <div class="card admin-login-card">
        
        <div class="admin-login-header">
          <div class="login-icon-badge">
            <Icons name="lock" size={26} />
          </div>
          <h1 class="login-title">
            Admin Authentication
          </h1>
          <p class="login-subtitle">
            Enter administrative password to manage notas and access biometric audit logs.
          </p>
        </div>

        <div id="login-error-alert" class="alert alert-danger" style="display: none;">
          <span id="login-error-text">Invalid password</span>
        </div>

        <form id="admin-login-form">
          <div class="form-group">
            <label for="admin-password" class="form-label">Admin Master Password</label>
            <input
              type="password"
              id="admin-password"
              name="password"
              class="form-input"
              placeholder="Enter admin password..."
              required
              autocomplete="current-password"
            />
          </div>

          <button type="submit" id="btn-login" class="btn btn-primary btn-block login-btn">
            <Icons name="lock" size={18} /> <span>Authenticate &amp; Enter Dashboard</span>
          </button>
        </form>

        <div class="login-footer">
          <a href="/" class="back-link">
            &larr; Back to Public Portal
          </a>
        </div>

      </div>
    </div>
  </div>
</Layout>

<style>
  .admin-login-wrapper {
    background-color: var(--color-gray-100);
    padding: clamp(2rem, 5vw, 4rem) 0;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: calc(100dvh - 120px);
  }

  .admin-login-card {
    padding: clamp(1.2rem, 3vw + 0.5rem, 2.25rem);
    box-shadow: var(--shadow-md);
    width: 100%;
  }

  .admin-login-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .login-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(48px, 10vw, 56px);
    height: clamp(48px, 10vw, 56px);
    background-color: var(--color-navy-900);
    color: #ffffff;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
  }

  .login-title {
    font-size: clamp(1.2rem, 2.5vw + 0.4rem, 1.45rem);
    color: var(--color-navy-900);
    margin-bottom: 0.25rem;
  }

  .login-subtitle {
    font-size: clamp(0.78rem, 0.9vw + 0.4rem, 0.85rem);
    color: var(--color-gray-500);
    line-height: 1.4;
  }

  .login-btn {
    padding: 0.8rem;
    font-size: clamp(0.85rem, 1vw + 0.45rem, 0.95rem);
    margin-top: 0.5rem;
  }

  .login-footer {
    text-align: center;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-gray-200);
  }

  .back-link {
    font-size: clamp(0.8rem, 1vw + 0.4rem, 0.85rem);
    color: var(--color-gray-600);
  }
</style>

<script>
  const form = document.getElementById('admin-login-form') as HTMLFormElement;
  const passwordInput = document.getElementById('admin-password') as HTMLInputElement;
  const errorAlert = document.getElementById('login-error-alert') as HTMLDivElement;
  const errorText = document.getElementById('login-error-text') as HTMLSpanElement;
  const btnLogin = document.getElementById('btn-login') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorAlert.style.display = 'none';
    btnLogin.disabled = true;
    btnLogin.textContent = 'Authenticating...';

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: passwordInput.value })
      });

      const json = await res.json();
      if (!json.success) {
        throw new Error(json.error?.message || 'Authentication failed');
      }

      // Successful login -> navigate to /admin
      window.location.href = '/admin';
    } catch (err: any) {
      errorAlert.style.display = 'block';
      errorText.textContent = err.message || 'Login failed';
      btnLogin.disabled = false;
      btnLogin.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Authenticate &amp; Enter Dashboard';
    }
  });
</script>
