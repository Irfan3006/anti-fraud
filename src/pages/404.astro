---
import Layout from '../layouts/Layout.astro';
import Icons from '../components/Icons.astro';

export const prerender = false;
---

<Layout
  title="404 - Halaman Tidak Ditemukan | Anti-Fraud Registry"
  description="Halaman atau dokumen nota yang Anda cari tidak ditemukan atau telah kedaluwarsa pada sistem verifikasi anti-fraud."
  noindex={true}
>
  <div class="stage-3d" id="stage-3d">
    <!-- Perspective Grid Background Plane -->
    <div class="bg-grid-plane"></div>

    <!-- 3D Physics Inertia Card Wrapper -->
    <div class="card-3d-wrapper" id="card-wrapper">
      <div class="card-3d" id="card-3d">
        
        <!-- Dynamic Glare Light Surface -->
        <div class="glare-surface" id="glare"></div>

        <!-- 3D Status Tag -->
        <div class="tag-row">
          <span class="status-tag">
            <Icons name="info" size={13} />
            <span>404 NOT FOUND // ERROR_STATE</span>
          </span>
        </div>

        <!-- 3D Extruded 404 Number -->
        <div class="number-row">
          <span class="code-3d">404</span>
        </div>

        <!-- Typography Content -->
        <div class="content-row">
          <h1 class="page-title">Halaman Tidak Ditemukan</h1>
          <p class="page-desc">
            Tautan yang Anda tuju tidak tersedia, URL tidak valid, atau dokumen nota telah kedaluwarsa pada sistem registry anti-fraud.
          </p>
        </div>

        <!-- High-Priority 100% Clickable Action Buttons -->
        <div class="actions-row">
          <a href="/" id="btn-home" class="btn-clean btn-primary" role="button">
            <Icons name="home" size={15} />
            <span>Ke Beranda</span>
          </a>

          <button type="button" id="btn-back" class="btn-clean btn-secondary">
            <Icons name="arrow-left" size={15} />
            <span>Kembali</span>
          </button>

          <a href="/admin" id="btn-admin" class="btn-clean btn-navy" role="button">
            <Icons name="shield" size={15} />
            <span>Admin</span>
          </a>
        </div>

        <!-- Dynamic Inertia Telemetry Footnote -->
        <div class="telemetry-row">
          <span class="telemetry-text" id="telemetry-display">ROT: [ X: +0.0° | Y: +0.0° ] &bull; TAMPER-PROOF REGISTRY</span>
        </div>

      </div>
    </div>
  </div>
</Layout>

<style>
  /* 3D Stage Container */
  .stage-3d {
    position: relative;
    min-height: calc(100vh - 140px);
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 3vw, 1.5rem);
    background: radial-gradient(circle at 50% 40%, #0a132c 0%, #030611 100%);
    perspective: 1000px;
    overflow: hidden;
  }

  /* Grid Background Plane */
  .bg-grid-plane {
    position: absolute;
    inset: -30%;
    background-image: 
      linear-gradient(rgba(59, 130, 246, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(59, 130, 246, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    transform: rotateX(60deg) scale(1.6);
    transform-origin: center 70%;
    pointer-events: none;
    opacity: 0.6;
  }

  /* 3D Wrapper */
  .card-3d-wrapper {
    position: relative;
    max-width: 540px;
    width: 100%;
    z-index: 10;
  }

  /* Main 3D Card */
  .card-3d {
    position: relative;
    width: 100%;
    background: rgba(11, 20, 48, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: clamp(16px, 3vw, 24px);
    padding: clamp(2rem, 5vw, 3rem) clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 
      0 25px 50px -12px rgba(0, 0, 0, 0.7),
      0 0 40px -10px rgba(59, 130, 246, 0.15),
      inset 0 1px 1px rgba(255, 255, 255, 0.15);
    will-change: transform;
    transform-style: flat;
  }

  /* Glare Specular Reflection */
  .glare-surface {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.12) 0%, transparent 65%);
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .tag-row {
    margin-bottom: 0.75rem;
  }

  .status-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* 3D Extruded Number */
  .number-row {
    margin-bottom: 0.5rem;
  }

  .code-3d {
    display: inline-block;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: clamp(4rem, 12vw, 5.75rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
    color: #ffffff;
    text-shadow: 
      0 1px 0 #94a3b8,
      0 2px 0 #64748b,
      0 3px 0 #475569,
      0 4px 0 #334155,
      0 15px 30px rgba(0, 0, 0, 0.6);
    user-select: none;
  }

  .page-title {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }

  .page-desc {
    font-size: clamp(0.82rem, 1.3vw, 0.92rem);
    color: #94a3b8;
    line-height: 1.6;
    max-width: 440px;
    margin: 0 auto 1.75rem auto;
  }

  /* Interactive Action Buttons - 100% Click Guaranteed */
  .actions-row {
    position: relative;
    z-index: 9999;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    margin-bottom: 1.5rem;
    width: 100%;
  }

  .btn-clean {
    position: relative;
    z-index: 9999;
    cursor: pointer !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.65rem 1.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: var(--radius-sm, 8px);
    text-decoration: none;
    border: none;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .btn-clean.btn-primary {
    background: #2563eb;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.45);
  }

  .btn-clean.btn-primary:hover {
    background: #1d4ed8;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.6);
  }

  .btn-clean.btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .btn-clean.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
  }

  .btn-clean.btn-navy {
    background: #0f1c3f;
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.4);
  }

  .btn-clean.btn-navy:hover {
    background: #172a5e;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(59, 130, 246, 0.3);
  }

  .btn-clean:active {
    transform: translateY(1px);
  }

  /* Telemetry Footnote */
  .telemetry-row {
    position: relative;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    width: 100%;
    pointer-events: none;
  }

  .telemetry-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0.06em;
  }

  @media (max-width: 480px) {
    .actions-row {
      flex-direction: column;
    }
    .btn-clean {
      width: 100%;
    }
  }
</style>

<script>
  // 3D Laggy Inertia Physics Controller
  const stageEl = document.getElementById('stage-3d');
  const cardEl = document.getElementById('card-3d');
  const glareEl = document.getElementById('glare');
  const telemetryEl = document.getElementById('telemetry-display');

  // Bulletproof Global Event Capture for Button Clicks
  document.addEventListener('click', (e: MouseEvent) => {
    const target = e.target ? (e.target as HTMLElement).closest('a, button') : null;
    if (!target) return;

    const id = target.getAttribute('id');
    if (id === 'btn-home' || target.classList.contains('btn-primary')) {
      e.preventDefault();
      e.stopPropagation();
      window.location.href = '/';
    } else if (id === 'btn-back' || target.classList.contains('btn-secondary')) {
      e.preventDefault();
      e.stopPropagation();
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/';
      }
    } else if (id === 'btn-admin' || target.classList.contains('btn-navy')) {
      e.preventDefault();
      e.stopPropagation();
      window.location.href = '/admin';
    }
  }, { capture: true });

  if (stageEl && cardEl) {
    const stage = stageEl;
    const card = cardEl;
    let targetRotX = 0;
    let targetRotY = 0;
    let currentRotX = 0;
    let currentRotY = 0;
    let glareX = 50;
    let glareY = 0;
    let targetGlareX = 50;
    let targetGlareY = 0;

    const LERP_FACTOR = 0.065; // Smooth inertia lag
    const MAX_TILT = 14; // Max degrees of 3D tilt

    function onMouseMove(e: MouseEvent) {
      const rect = stage.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;

      targetRotX = -y * MAX_TILT;
      targetRotY = x * MAX_TILT;
      targetGlareX = (x + 0.5) * 100;
      targetGlareY = (y + 0.5) * 100;
    }

    function onMouseLeave() {
      targetRotX = 0;
      targetRotY = 0;
      targetGlareX = 50;
      targetGlareY = 0;
    }

    stage.addEventListener('mousemove', onMouseMove);
    stage.addEventListener('mouseleave', onMouseLeave);

    // Mobile / Touch / Ambient Float Loop
    let time = 0;
    let isTouch = 'ontouchstart' in window || (navigator && navigator.maxTouchPoints > 0);

    function renderLoop() {
      time += 0.025;

      if (isTouch && targetRotX === 0 && targetRotY === 0) {
        targetRotX = Math.sin(time) * 3.5;
        targetRotY = Math.cos(time * 0.8) * 4.5;
        targetGlareX = 50 + Math.cos(time * 0.8) * 18;
        targetGlareY = 30 + Math.sin(time) * 18;
      }

      // Linear Interpolation (Physics Inertia Lag)
      currentRotX += (targetRotX - currentRotX) * LERP_FACTOR;
      currentRotY += (targetRotY - currentRotY) * LERP_FACTOR;
      glareX += (targetGlareX - glareX) * LERP_FACTOR;
      glareY += (targetGlareY - glareY) * LERP_FACTOR;

      // Apply 3D Transform to card
      card.style.transform = `rotateX(${currentRotX.toFixed(2)}deg) rotateY(${currentRotY.toFixed(2)}deg)`;

      if (glareEl) {
        glareEl.style.background = `radial-gradient(circle at ${glareX.toFixed(1)}% ${glareY.toFixed(1)}%, rgba(255, 255, 255, 0.15) 0%, transparent 65%)`;
      }

      if (telemetryEl) {
        const signX = currentRotX >= 0 ? '+' : '';
        const signY = currentRotY >= 0 ? '+' : '';
        telemetryEl.textContent = `ROT: [ X: ${signX}${currentRotX.toFixed(1)}° | Y: ${signY}${currentRotY.toFixed(1)}° ] • TAMPER-PROOF REGISTRY`;
      }

      requestAnimationFrame(renderLoop);
    }

    renderLoop();
  }
</script>
