---
import Layout from '../layouts/Layout.astro';
import Icons from '../components/Icons.astro';
import { listNotas } from '../lib/storage';
import { fetchLiveNotasFromAppsScript } from '../lib/apps-script';
import { formatWIB } from '../lib/security';

export const prerender = false;

// Fetch live registered notas
const [remoteNotas, localNotas] = await Promise.all([
  fetchLiveNotasFromAppsScript().catch(() => []),
  Promise.resolve(listNotas())
]);

const notaMap = new Map();
remoteNotas.forEach((n) => notaMap.set(n.id, n));
localNotas.forEach((n) => {
  if (!notaMap.has(n.id)) {
    notaMap.set(n.id, n);
  }
});

const sampleNotas = Array.from(notaMap.values()).sort(
  (a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()
);
const demoNota = sampleNotas[0] || { id: '8f92a7c1', notaNumber: 'INV-2026-00123', title: 'Faktur Resmi Security Server' };
---

<Layout
  title="Anti-Fraud Nota Verification | Secure Anti-Tamper Document Gateway"
  description="Platform keamanan dokumen dan faktur finansial anti-fraud dengan verifikasi biometrik, GPS presisi tinggi, dan audit trail Google Cloud."
>
  <!-- HERO SECTION -->
  <section class="hero-section">
    <!-- Tech Background Grid -->
    <div class="hero-bg-grid"></div>
    
    <!-- Ambient Blue Glow -->
    <div class="hero-ambient-glow"></div>

    <div class="container hero-container">
      <div class="hero-grid">
        
        <!-- Hero Left Column -->
        <div class="hero-left">
          <!-- Status Pill Badge -->
          <div class="hero-status-pill">
            <span class="live-pulse-dot"></span>
            <Icons name="shield-check" size={15} />
            <span class="pill-text">Enterprise Zero-Trust Document Registry</span>
          </div>

          <h1 class="hero-title">
            Sistem Verifikasi Nota &amp; Dokumen <span class="gradient-text">Anti-Fraud</span>
          </h1>

          <p class="hero-description">
            Lindungi integritas dokumen faktur dan nota transaksi dari pemalsuan. Konten terkunci secara server-side dan hanya dapat diakses setelah verifikasi identitas, GPS presisi tinggi, serta kamera ganda anti-spoofing.
          </p>

          <!-- Action Buttons -->
          <div class="hero-actions">
            <a
              href={`/nota/${demoNota.id}`}
              class="btn btn-blue hero-btn-primary"
            >
              <Icons name="lock" size={17} /> <span>Buka Gerbang Verifikasi</span>
            </a>
            
            <a
              href="/admin"
              class="btn hero-btn-secondary"
            >
              <Icons name="user" size={17} /> <span>Admin Dashboard</span>
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="hero-trust-badges">
            <div class="trust-badge-item">
              <Icons name="shield" size={15} class="text-blue" />
              <span>Proteksi Serverless SSR</span>
            </div>
            <div class="trust-badge-item">
              <Icons name="map-pin" size={15} class="text-blue" />
              <span>Audit Koordinat GPS</span>
            </div>
            <div class="trust-badge-item">
              <Icons name="camera" size={15} class="text-blue" />
              <span>Dual Camera Capture</span>
            </div>
          </div>
        </div>

        <!-- Hero Right Column: 3D Interactive Security Card Preview -->
        <div class="hero-right">
          
          <!-- Floating 3D Hologram Badge 1 (Top Right) -->
          <div class="floating-3d-badge badge-gps">
            <span class="pulse-dot-blue"></span>
            <Icons name="map-pin" size={14} />
            <span>GPS Satellite Lock &plusmn;8m</span>
          </div>

          <!-- Floating 3D Hologram Badge 2 (Bottom Left) -->
          <div class="floating-3d-badge badge-cam">
            <span class="pulse-dot-green"></span>
            <Icons name="camera" size={14} />
            <span>Dual Camera Anti-Spoofing</span>
          </div>

          <!-- The Main 3D Tilted Card -->
          <div id="hero-3d-card" class="hero-card-surface">
            <!-- Dynamic 3D Glare Overlay -->
            <div id="card-glare" class="card-glare-overlay"></div>

            <!-- Card Header (Depth Layer 1) -->
            <div class="hero-card-header">
              <div class="locked-status">
                <div class="pulse-dot-red"></div>
                <span class="locked-text">LOCKED DOCUMENT</span>
              </div>
              <span class="nota-number-pill">
                {demoNota.notaNumber}
              </span>
            </div>

            <!-- Simulated Document Card Body (Depth Layer 2) -->
            <div class="hero-card-body">
              <div class="lock-icon-circle">
                <Icons name="lock" size={26} />
              </div>
              <h3 class="hero-card-doc-title">
                {demoNota.title}
              </h3>
              <p class="hero-card-doc-sub">
                Dokumen finansial resmi terenkripsi secara kriptografis &amp; terlindungi server-side.
              </p>

              <!-- Live Verification Checklist Indicators (Depth Layer 3) -->
              <div class="verification-checks-grid">
                <div class="check-pill">
                  <Icons name="check" size={13} class="text-blue" /> <span>Device Hash</span>
                </div>
                <div class="check-pill">
                  <Icons name="check" size={13} class="text-blue" /> <span>GPS Geolocation</span>
                </div>
                <div class="check-pill">
                  <Icons name="check" size={13} class="text-blue" /> <span>Kamera Depan</span>
                </div>
                <div class="check-pill">
                  <Icons name="check" size={13} class="text-blue" /> <span>Kamera Belakang</span>
                </div>
              </div>
            </div>

            <!-- Card Footer Action (Depth Layer 4) -->
            <a
              href={`/nota/${demoNota.id}`}
              class="btn btn-blue btn-block hero-card-action"
            >
              <span>Uji Coba Verifikasi Instan</span> <Icons name="arrow-right" size={15} />
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- STATS HIGHLIGHT STRIP -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-value text-blue">100%</div>
          <div class="stat-label">Server-Side Zero Trust</div>
        </div>

        <div class="stat-card">
          <div class="stat-value text-green">&lt; 2.5s</div>
          <div class="stat-label">Kecepatan Verifikasi Paralel</div>
        </div>

        <div class="stat-card">
          <div class="stat-value text-blue">26 Kolom</div>
          <div class="stat-label">Audit Trail Telemetri &amp; GPS</div>
        </div>

        <div class="stat-card">
          <div class="stat-value text-purple">Google Cloud</div>
          <div class="stat-label">Drive &amp; Sheets Live Sync</div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS / PIPELINE SHOWCASE -->
  <section class="features-section">
    <div class="container">
      <div class="section-heading-centered">
        <div class="section-pretitle">
          <Icons name="zap" size={14} /> Alur Kerja Keamanan Dokumen
        </div>
        <h2 class="section-title">
          Proteksi Berlapis Tanpa Celah Pemalsuan
        </h2>
        <p class="section-subtitle">
          Setiap faktur yang didaftarkan diamankan dengan token kriptografi, validasi sensor ganda, dan perekaman jejak audit otomatis.
        </p>
      </div>

      <div class="features-grid">
        
        <!-- Step 1 -->
        <div class="card feature-step-card card-blue-top">
          <div class="feature-icon-box bg-blue-light text-blue">
            <Icons name="lock" size={22} />
          </div>
          <h3 class="feature-step-title">
            1. Gerbang Serverless Terkunci
          </h3>
          <p class="feature-step-desc">
            Data nota asli disimpan aman di server. Tidak ada data rahasia yang dikirimkan ke browser sebelum verifikasi sukses.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="card feature-step-card card-navy-top">
          <div class="feature-icon-box bg-gray-light text-navy">
            <Icons name="map-pin" size={22} />
          </div>
          <h3 class="feature-step-title">
            2. Titik Lokasi GPS Presisi
          </h3>
          <p class="feature-step-desc">
            Mengambil koordinat satelit GPS dengan akurasi meter nyata, terhubung langsung ke Google Maps live link.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="card feature-step-card card-blue-top">
          <div class="feature-icon-box bg-blue-light text-blue">
            <Icons name="camera" size={22} />
          </div>
          <h3 class="feature-step-title">
            3. Tangkapan Kamera Ganda
          </h3>
          <p class="feature-step-desc">
            Pengambilan frame kamera depan &amp; belakang secara otomatis dan senyap untuk memastikan keberadaan fisik pengguna.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="card feature-step-card card-success-top">
          <div class="feature-icon-box bg-green-light text-green">
            <Icons name="shield-check" size={22} />
          </div>
          <h3 class="feature-step-title">
            4. Arsip Cloud &amp; Buka Kunci
          </h3>
          <p class="feature-step-desc">
            Seluruh bukti diarsipkan otomatis ke Google Drive &amp; Google Sheet, dan dokumen nota langsung terbuka seketika.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- REGISTERED NOTAS TABLE SECTION -->
  <section class="registered-notas-section">
    <div class="container">
      <div class="table-section-header">
        <div>
          <div class="table-section-pretitle">
            Daftar Dokumen Aktif
          </div>
          <h2 class="table-section-title">
            Dokumen &amp; Faktur Terdaftar ({sampleNotas.length})
          </h2>
          <p class="table-section-sub">
            Pilih dokumen untuk mencoba alur verifikasi anti-fraud secara langsung.
          </p>
        </div>

        <a href="/admin/create" class="btn btn-primary btn-create-nota">
          <Icons name="edit" size={15} /> <span>Buat Dokumen Baru</span>
        </a>
      </div>

      <div class="card table-card">
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Nomor Invoice</th>
                <th>Judul Dokumen</th>
                <th>Status Keamanan</th>
                <th>Waktu Dibuat (WIB)</th>
                <th style="text-align: right;">Aksi Verifikasi</th>
              </tr>
            </thead>
            <tbody>
              {sampleNotas.map((nota) => (
                <tr>
                  <td>
                    <strong class="invoice-number-text">
                      {nota.notaNumber}
                    </strong>
                  </td>
                  <td class="document-title-cell">
                    {nota.title}
                  </td>
                  <td>
                    <span class="badge badge-warning lock-badge">
                      <Icons name="lock" size={11} /> LOCKED (PROTECTED)
                    </span>
                  </td>
                  <td class="created-time-cell">
                    {formatWIB(nota.createdAt)}
                  </td>
                  <td style="text-align: right; white-space: nowrap;">
                    <a
                      href={`/nota/${nota.id}`}
                      class="btn btn-blue table-action-btn"
                    >
                      <span>Buka Verifikasi</span> <Icons name="arrow-right" size={13} />
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section Styling */
  .hero-section {
    background: radial-gradient(circle at 50% 0%, #1e293b 0%, #070d1e 75%, #030712 100%);
    color: #ffffff;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 5vw, 4rem) 0;
    border-bottom: 1px solid rgba(59, 130, 246, 0.15);
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .hero-bg-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(37, 99, 235, 0.08) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }

  .hero-ambient-glow {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: min(600px, 90vw);
    height: 350px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.25) 0%, rgba(29, 78, 216, 0.05) 60%, transparent 80%);
    filter: blur(50px);
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .hero-left {
    min-width: 0;
  }

  .hero-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(59, 130, 246, 0.35);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
    font-size: clamp(0.7rem, 0.9vw + 0.4rem, 0.78rem);
    color: #93c5fd;
    backdrop-filter: blur(8px);
    box-shadow: 0 0 20px rgba(37, 99, 235, 0.15);
    max-width: 100%;
  }

  .live-pulse-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 8px #22c55e;
    flex-shrink: 0;
  }

  .pill-text {
    font-weight: 600;
    letter-spacing: 0.3px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero-title {
    font-size: clamp(1.6rem, 4vw + 0.6rem, 2.6rem);
    color: #ffffff;
    margin-bottom: 1rem;
    line-height: 1.18;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .gradient-text {
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 50%, #1d4ed8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: clamp(0.88rem, 1.2vw + 0.5rem, 1.05rem);
    color: #94a3b8;
    margin-bottom: 1.75rem;
    line-height: 1.65;
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .hero-btn-primary {
    font-size: 0.95rem;
    padding: 0.75rem 1.4rem;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
    font-weight: 700;
  }

  .hero-btn-secondary {
    font-size: 0.95rem;
    padding: 0.75rem 1.4rem;
    background: rgba(30, 41, 59, 0.8);
    color: #f1f5f9;
    border: 1px solid rgba(148, 163, 184, 0.25);
    backdrop-filter: blur(6px);
    font-weight: 600;
  }

  .hero-trust-badges {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    flex-wrap: wrap;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1.25rem;
  }

  .trust-badge-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: clamp(0.72rem, 0.8vw + 0.45rem, 0.8rem);
    color: #cbd5e1;
  }

  .hero-right {
    perspective: 1200px;
    display: flex;
    justify-content: center;
    position: relative;
    width: 100%;
  }

  .floating-3d-badge {
    position: absolute;
    z-index: 10;
    background: rgba(15, 23, 42, 0.92);
    border-radius: var(--radius-md);
    padding: 0.4rem 0.75rem;
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    font-weight: 700;
    pointer-events: none;
  }

  .badge-gps {
    top: -14px;
    right: -10px;
    border: 1px solid rgba(59, 130, 246, 0.4);
    box-shadow: 0 12px 25px rgba(0,0,0,0.5), 0 0 15px rgba(37, 99, 235, 0.3);
    color: #60a5fa;
    animation: floatBadge1 4s ease-in-out infinite;
  }

  .badge-cam {
    bottom: -16px;
    left: -10px;
    border: 1px solid rgba(34, 197, 94, 0.4);
    box-shadow: 0 12px 25px rgba(0,0,0,0.5), 0 0 15px rgba(34, 197, 94, 0.25);
    color: #4ade80;
    animation: floatBadge2 4.5s ease-in-out infinite;
  }

  .pulse-dot-blue {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: #3b82f6;
    border-radius: 50%;
    box-shadow: 0 0 8px #3b82f6;
    flex-shrink: 0;
  }

  .pulse-dot-green {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 8px #22c55e;
    flex-shrink: 0;
  }

  .pulse-dot-red {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: pulseRed 2s infinite;
    flex-shrink: 0;
  }

  .hero-card-surface {
    width: 100%;
    max-width: 440px;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: var(--radius-xl);
    padding: clamp(1rem, 3vw, 1.6rem);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 30px rgba(37, 99, 235, 0.2);
    backdrop-filter: blur(16px);
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.15s ease-out, box-shadow 0.25s ease;
    overflow: hidden;
  }

  .card-glare-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.12) 0%, transparent 60%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: inherit;
    z-index: 1;
  }

  .hero-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.85rem;
    margin-bottom: 1rem;
    transform: translateZ(25px);
    position: relative;
    z-index: 2;
    gap: 0.5rem;
  }

  .locked-status {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .locked-text {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: #f87171;
    letter-spacing: 0.5px;
  }

  .nota-number-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #94a3b8;
    background: rgba(30, 41, 59, 0.85);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    font-weight: 600;
  }

  .hero-card-body {
    background: rgba(2, 6, 23, 0.75);
    border: 1px solid rgba(37, 99, 235, 0.25);
    border-radius: var(--radius-md);
    padding: clamp(0.85rem, 2vw, 1.25rem);
    margin-bottom: 1.1rem;
    text-align: center;
    transform: translateZ(35px);
    position: relative;
    z-index: 2;
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
  }

  .lock-icon-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(48px, 10vw, 58px);
    height: clamp(48px, 10vw, 58px);
    background: rgba(37, 99, 235, 0.15);
    color: #3b82f6;
    border-radius: 50%;
    margin-bottom: 0.75rem;
    border: 1px solid rgba(59, 130, 246, 0.4);
    transform: translateZ(45px);
    box-shadow: 0 0 20px rgba(37, 99, 235, 0.25);
  }

  .hero-card-doc-title {
    font-size: clamp(0.95rem, 1.5vw + 0.4rem, 1.1rem);
    color: #ffffff;
    margin-bottom: 0.3rem;
    font-weight: 700;
    transform: translateZ(30px);
  }

  .hero-card-doc-sub {
    font-size: clamp(0.72rem, 1vw + 0.35rem, 0.8rem);
    color: #94a3b8;
    margin-bottom: 0.95rem;
    line-height: 1.4;
    transform: translateZ(25px);
  }

  .verification-checks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem;
    text-align: left;
    font-size: clamp(0.68rem, 0.8vw + 0.35rem, 0.75rem);
    transform: translateZ(30px);
  }

  .check-pill {
    background: rgba(15, 23, 42, 0.85);
    padding: 0.4rem 0.55rem;
    border-radius: 4px;
    border: 1px solid rgba(59, 130, 246, 0.2);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: #cbd5e1;
    overflow: hidden;
  }

  .hero-card-action {
    font-size: 0.9rem;
    padding: 0.75rem;
    font-weight: 700;
    transform: translateZ(40px);
    position: relative;
    z-index: 2;
    box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
  }

  /* Stats Section */
  .stats-section {
    background: var(--color-navy-900);
    border-bottom: 1px solid var(--color-navy-800);
    padding: clamp(1.25rem, 3vw, 2rem) 0;
    width: 100%;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 130px), 1fr));
    gap: clamp(0.65rem, 2vw, 1.25rem);
    text-align: center;
  }

  .stat-card {
    padding: clamp(0.75rem, 1.5vw, 1rem);
    border-radius: var(--radius-md);
    background: rgba(30, 41, 59, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .stat-value {
    font-size: clamp(1.3rem, 3vw + 0.4rem, 1.8rem);
    font-weight: 800;
    margin-bottom: 0.2rem;
    font-family: var(--font-mono);
  }

  .stat-label {
    font-size: clamp(0.7rem, 0.8vw + 0.35rem, 0.82rem);
    color: #94a3b8;
    font-weight: 600;
    line-height: 1.3;
  }

  .text-blue { color: #60a5fa; }
  .text-green { color: #34d399; }
  .text-purple { color: #a78bfa; }
  .text-navy { color: var(--color-navy-900); }

  /* Features Section */
  .features-section {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(2rem, 4vw, 4rem) 0;
